{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Fortress Key",
  "version": "1.0.0",
  "identifier": "info.cryptostandard.fortress-key",
  "build": {
    "frontendDist": "../src",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Fortress Key - Offline Cold Wallet Security",
        "width": 960,
        "height": 700,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
